{
  "info": {
    "name": "TapPay NFC Wallet API",
    "description": "Koleksi lengkap API TapPay (Auth, Wallet, NFC, Transfer/Open Payment, Merchant, Transaction, Statement, Profile). Token login otomatis tersimpan ke collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000/api" },
    { "key": "token", "value": "" },
    { "key": "token_a", "value": "" },
    { "key": "token_b", "value": "" },
    { "key": "token_merchant", "value": "" },
    { "key": "nfc_token", "value": "" },
    { "key": "transfer_id", "value": "" },
    { "key": "transaction_id", "value": "" },
    { "key": "transaction_code", "value": "" },
    { "key": "statement_id", "value": "" },
    { "key": "customer_phone", "value": "082222222222" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Customer",
          "request": {
            "method": "POST",
            "header": [ { "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{base_url}}/auth/register", "host": ["{{base_url}}"], "path": ["auth","register"] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Customer Baru\",\n  \"email\": \"baru@mail.com\",\n  \"phone\": \"081299990001\",\n  \"role\": \"customer\",\n  \"password\": \"secret123\",\n  \"password_confirmation\": \"secret123\"\n}" }
          }
        },
        {
          "name": "Register Merchant",
          "request": {
            "method": "POST",
            "header": [ { "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{base_url}}/auth/register", "host": ["{{base_url}}"], "path": ["auth","register"] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Merchant Baru\",\n  \"email\": \"merchantbaru@mail.com\",\n  \"phone\": \"081299990002\",\n  \"role\": \"merchant\",\n  \"password\": \"secret123\",\n  \"password_confirmation\": \"secret123\"\n}" }
          }
        },
        {
          "name": "Login Customer A",
          "event": [ { "listen": "test", "script": { "exec": [
            "var d = pm.response.json();",
            "if (d.data && d.data.access_token) {",
            "  pm.collectionVariables.set('token', d.data.access_token);",
            "  pm.collectionVariables.set('token_a', d.data.access_token);",
            "}"
          ], "type": "text/javascript" } } ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth","login"] },
            "body": { "mode": "raw", "raw": "{\n  \"identifier\": \"customer@tappay.test\",\n  \"password\": \"password\",\n  \"device_name\": \"postman-a\"\n}" }
          }
        },
        {
          "name": "Login Customer B",
          "event": [ { "listen": "test", "script": { "exec": [
            "var d = pm.response.json();",
            "if (d.data && d.data.access_token) {",
            "  pm.collectionVariables.set('token_b', d.data.access_token);",
            "}"
          ], "type": "text/javascript" } } ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth","login"] },
            "body": { "mode": "raw", "raw": "{\n  \"identifier\": \"customer.b@tappay.test\",\n  \"password\": \"password\",\n  \"device_name\": \"postman-b\"\n}" }
          }
        },
        {
          "name": "Login Merchant",
          "event": [ { "listen": "test", "script": { "exec": [
            "var d = pm.response.json();",
            "if (d.data && d.data.access_token) {",
            "  pm.collectionVariables.set('token_merchant', d.data.access_token);",
            "}"
          ], "type": "text/javascript" } } ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth","login"] },
            "body": { "mode": "raw", "raw": "{\n  \"identifier\": \"merchant@tappay.test\",\n  \"password\": \"password\",\n  \"device_name\": \"postman-merchant\"\n}" }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [ { "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{base_url}}/auth/me", "host": ["{{base_url}}"], "path": ["auth","me"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [ { "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{base_url}}/auth/logout", "host": ["{{base_url}}"], "path": ["auth","logout"] }
          }
        }
      ]
    },
    {
      "name": "Profile",
      "item": [
        { "name": "Get Profile", "request": { "method": "GET", "header": [ {"key":"Accept","value":"application/json"}, {"key":"Authorization","value":"Bearer {{token}}"} ], "url": { "raw": "{{base_url}}/profile", "host":["{{base_url}}"], "path":["profile"] } } },
        { "name": "Update Profile", "request": { "method": "PATCH", "header": [ {"key":"Accept","value":"application/json"}, {"key":"Content-Type","value":"application/json"}, {"key":"Authorization","value":"Bearer {{token}}"} ], "url": { "raw": "{{base_url}}/profile", "host":["{{base_url}}"], "path":["profile"] }, "body": { "mode":"raw", "raw":"{\n  \"name\": \"Customer A Updated\"\n}" } } },
        { "name": "Set PIN", "request": { "method": "POST", "header": [ {"key":"Accept","value":"application/json"}, {"key":"Content-Type","value":"application/json"}, {"key":"Authorization","value":"Bearer {{token}}"} ], "url": { "raw": "{{base_url}}/profile/set-pin", "host":["{{base_url}}"], "path":["profile","set-pin"] }, "body": { "mode":"raw", "raw":"{\n  \"pin\": \"123456\",\n  \"pin_confirmation\": \"123456\"\n}" } } },
        { "name": "Change Password", "request": { "method": "POST", "header": [ {"key":"Accept","value":"application/json"}, {"key":"Content-Type","value":"application/json"}, {"key":"Authorization","value":"Bearer {{token}}"} ], "url": { "raw": "{{base_url}}/profile/change-password", "host":["{{base_url}}"], "path":["profile","change-password"] }, "body": { "mode":"raw", "raw":"{\n  \"current_password\": \"password\",\n  \"password\": \"password\",\n  \"password_confirmation\": \"password\"\n}" } } },
        { "name": "Devices", "request": { "method": "GET", "header": [ {"key":"Accept","value":"application/json"}, {"key":"Authorization","value":"Bearer {{token}}"} ], "url": { "raw": "{{base_url}}/profile/devices", "host":["{{base_url}}"], "path":["profile","devices"] } } },
        { "name": "Logout All Devices", "request": { "method": "POST", "header": [ {"key":"Accept","value":"application/json"}, {"key":"Authorization","value":"Bearer {{token}}"} ], "url": { "raw": "{{base_url}}/profile/logout-all-devices", "host":["{{base_url}}"], "path":["profile","logout-all-devices"] } } }
      ]
    },
    {
      "name": "Wallet",
      "item": [
        { "name": "Get Wallet", "request": { "method": "GET", "header": [ {"key":"Accept","value":"application/json"}, {"key":"Authorization","value":"Bearer {{token}}"} ], "url": { "raw": "{{base_url}}/wallet", "host":["{{base_url}}"], "path":["wallet"] } } },
        { "name": "Balance", "request": { "method": "GET", "header": [ {"key":"Accept","value":"application/json"}, {"key":"Authorization","value":"Bearer {{token}}"} ], "url": { "raw": "{{base_url}}/wallet/balance", "host":["{{base_url}}"], "path":["wallet","balance"] } } },
        { "name": "History", "request": { "method": "GET", "header": [ {"key":"Accept","value":"application/json"}, {"key":"Authorization","value":"Bearer {{token}}"} ], "url": { "raw": "{{base_url}}/wallet/history", "host":["{{base_url}}"], "path":["wallet","history"] } } },
        { "name": "Ledger (debit/credit)", "request": { "method": "GET", "header": [ {"key":"Accept","value":"application/json"}, {"key":"Authorization","value":"Bearer {{token}}"} ], "url": { "raw": "{{base_url}}/wallet/ledger", "host":["{{base_url}}"], "path":["wallet","ledger"] } } }
      ]
    },
    {
      "name": "NFC (Receiver = Customer B)",
      "item": [
        {
          "name": "Create Receive Session",
          "event": [ { "listen": "test", "script": { "exec": [
            "var d = pm.response.json();",
            "if (d.data && d.data.session) {",
            "  pm.collectionVariables.set('nfc_token', d.data.session.nfc_token);",
            "}"
          ], "type": "text/javascript" } } ],
          "request": { "method": "POST", "header": [ {"key":"Accept","value":"application/json"}, {"key":"Content-Type","value":"application/json"}, {"key":"Authorization","value":"Bearer {{token_b}}"} ], "url": { "raw": "{{base_url}}/nfc/sessions", "host":["{{base_url}}"], "path":["nfc","sessions"] }, "body": { "mode":"raw", "raw":"{\n  \"mode\": \"receive_payment\"\n}" } }
        },
        { "name": "Get Session By Token", "request": { "method": "GET", "header": [ {"key":"Accept","value":"application/json"}, {"key":"Authorization","value":"Bearer {{token_b}}"} ], "url": { "raw": "{{base_url}}/nfc/sessions/{{nfc_token}}", "host":["{{base_url}}"], "path":["nfc","sessions","{{nfc_token}}"] } } }
      ]
    },
    {
      "name": "Open Payment (Transfer C2C)",
      "item": [
        {
          "name": "1. Initiate (Customer A -> token B)",
          "event": [ { "listen": "test", "script": { "exec": [
            "var d = pm.response.json();",
            "if (d.data) {",
            "  pm.collectionVariables.set('transaction_id', d.data.transaction_id);",
            "  pm.collectionVariables.set('transfer_id', d.data.transaction_id);",
            "  pm.collectionVariables.set('transaction_code', d.data.transaction_code);",
            "}"
          ], "type": "text/javascript" } } ],
          "request": { "method": "POST", "header": [ {"key":"Accept","value":"application/json"}, {"key":"Content-Type","value":"application/json"}, {"key":"Authorization","value":"Bearer {{token_a}}"}, {"key":"Idempotency-Key","value":"pay-{{$timestamp}}"}, {"key":"X-Device-ID","value":"device-a"} ], "url": { "raw": "{{base_url}}/open-payment/initiate", "host":["{{base_url}}"], "path":["open-payment","initiate"] }, "body": { "mode":"raw", "raw":"{\n  \"receiver_nfc_token\": \"{{nfc_token}}\",\n  \"amount\": 20000,\n  \"notes\": \"Transfer saldo\"\n}" } }
        },
        { "name": "2. Approve (Customer B + PIN)", "request": { "method": "POST", "header": [ {"key":"Accept","value":"application/json"}, {"key":"Content-Type","value":"application/json"}, {"key":"Authorization","value":"Bearer {{token_b}}"}, {"key":"X-Device-ID","value":"device-b"} ], "url": { "raw": "{{base_url}}/open-payment/approve", "host":["{{base_url}}"], "path":["open-payment","approve"] }, "body": { "mode":"raw", "raw":"{\n  \"transaction_id\": {{transaction_id}},\n  \"pin\": \"123456\",\n  \"device_id\": \"device-b\"\n}" } } },
        { "name": "Reject (Customer B)", "request": { "method": "POST", "header": [ {"key":"Accept","value":"application/json"}, {"key":"Content-Type","value":"application/json"}, {"key":"Authorization","value":"Bearer {{token_b}}"} ], "url": { "raw": "{{base_url}}/open-payment/reject", "host":["{{base_url}}"], "path":["open-payment","reject"] }, "body": { "mode":"raw", "raw":"{\n  \"transaction_id\": {{transaction_id}},\n  \"reason\": \"Nominal tidak sesuai\"\n}" } } },
        { "name": "Status by code", "request": { "method": "GET", "header": [ {"key":"Accept","value":"application/json"}, {"key":"Authorization","value":"Bearer {{token_a}}"} ], "url": { "raw": "{{base_url}}/open-payment/status/{{transaction_code}}", "host":["{{base_url}}"], "path":["open-payment","status","{{transaction_code}}"] } } },
        { "name": "Balance Inquiry", "request": { "method": "GET", "header": [ {"key":"Accept","value":"application/json"}, {"key":"Authorization","value":"Bearer {{token_a}}"} ], "url": { "raw": "{{base_url}}/open-payment/balance", "host":["{{base_url}}"], "path":["open-payment","balance"] } } },
        { "name": "Receipt by code", "request": { "method": "GET", "header": [ {"key":"Accept","value":"application/json"}, {"key":"Authorization","value":"Bearer {{token_a}}"} ], "url": { "raw": "{{base_url}}/open-payment/receipt/{{transaction_code}}", "host":["{{base_url}}"], "path":["open-payment","receipt","{{transaction_code}}"] } } }
      ]
    },
    {
      "name": "Transfers (alias)",
      "item": [
        { "name": "Pending Incoming (B)", "request": { "method": "GET", "header": [ {"key":"Accept","value":"application/json"}, {"key":"Authorization","value":"Bearer {{token_b}}"} ], "url": { "raw": "{{base_url}}/transfers/pending-incoming", "host":["{{base_url}}"], "path":["transfers","pending-incoming"] } } },
        { "name": "Transfer Detail", "request": { "method": "GET", "header": [ {"key":"Accept","value":"application/json"}, {"key":"Authorization","value":"Bearer {{token_b}}"} ], "url": { "raw": "{{base_url}}/transfers/{{transfer_id}}", "host":["{{base_url}}"], "path":["transfers","{{transfer_id}}"] } } },
        { "name": "Approve via /transfers/{id}/approve", "request": { "method": "POST", "header": [ {"key":"Accept","value":"application/json"}, {"key":"Content-Type","value":"application/json"}, {"key":"Authorization","value":"Bearer {{token_b}}"} ], "url": { "raw": "{{base_url}}/transfers/{{transfer_id}}/approve", "host":["{{base_url}}"], "path":["transfers","{{transfer_id}}","approve"] }, "body": { "mode":"raw", "raw":"{\n  \"pin\": \"123456\"\n}" } } },
        { "name": "Reject via /transfers/{id}/reject", "request": { "method": "POST", "header": [ {"key":"Accept","value":"application/json"}, {"key":"Content-Type","value":"application/json"}, {"key":"Authorization","value":"Bearer {{token_b}}"} ], "url": { "raw": "{{base_url}}/transfers/{{transfer_id}}/reject", "host":["{{base_url}}"], "path":["transfers","{{transfer_id}}","reject"] }, "body": { "mode":"raw", "raw":"{\n  \"reason\": \"Salah orang\"\n}" } } },
        { "name": "Cancel (Sender A)", "request": { "method": "POST", "header": [ {"key":"Accept","value":"application/json"}, {"key":"Authorization","value":"Bearer {{token_a}}"} ], "url": { "raw": "{{base_url}}/transfers/{{transfer_id}}/cancel", "host":["{{base_url}}"], "path":["transfers","{{transfer_id}}","cancel"] } } }
      ]
    },
    {
      "name": "Merchant",
      "item": [
        { "name": "Summary", "request": { "method": "GET", "header": [ {"key":"Accept","value":"application/json"}, {"key":"Authorization","value":"Bearer {{token_merchant}}"} ], "url": { "raw": "{{base_url}}/merchant/summary", "host":["{{base_url}}"], "path":["merchant","summary"] } } },
        { "name": "Limits", "request": { "method": "GET", "header": [ {"key":"Accept","value":"application/json"}, {"key":"Authorization","value":"Bearer {{token_merchant}}"} ], "url": { "raw": "{{base_url}}/merchant/limits", "host":["{{base_url}}"], "path":["merchant","limits"] } } },
        { "name": "Search Customer", "request": { "method": "GET", "header": [ {"key":"Accept","value":"application/json"}, {"key":"Authorization","value":"Bearer {{token_merchant}}"} ], "url": { "raw": "{{base_url}}/customers/search?phone={{customer_phone}}", "host":["{{base_url}}"], "path":["customers","search"], "query":[{"key":"phone","value":"{{customer_phone}}"}] } } },
        {
          "name": "Top Up Customer",
          "event": [ { "listen": "test", "script": { "exec": [
            "var d = pm.response.json();",
            "if (d.data && d.data.transaction) {",
            "  pm.collectionVariables.set('transaction_id', d.data.transaction.id);",
            "  pm.collectionVariables.set('transaction_code', d.data.transaction.transaction_code);",
            "}"
          ], "type": "text/javascript" } } ],
          "request": { "method": "POST", "header": [ {"key":"Accept","value":"application/json"}, {"key":"Content-Type","value":"application/json"}, {"key":"Authorization","value":"Bearer {{token_merchant}}"}, {"key":"Idempotency-Key","value":"topup-{{$timestamp}}"} ], "url": { "raw": "{{base_url}}/merchant/topups", "host":["{{base_url}}"], "path":["merchant","topups"] }, "body": { "mode":"raw", "raw":"{\n  \"customer_phone\": \"{{customer_phone}}\",\n  \"amount\": 100000,\n  \"notes\": \"Top up merchant\"\n}" } }
        },
        { "name": "Top Up History", "request": { "method": "GET", "header": [ {"key":"Accept","value":"application/json"}, {"key":"Authorization","value":"Bearer {{token_merchant}}"} ], "url": { "raw": "{{base_url}}/merchant/topups", "host":["{{base_url}}"], "path":["merchant","topups"] } } },
        { "name": "Top Up Recent", "request": { "method": "GET", "header": [ {"key":"Accept","value":"application/json"}, {"key":"Authorization","value":"Bearer {{token_merchant}}"} ], "url": { "raw": "{{base_url}}/merchant/topups/recent", "host":["{{base_url}}"], "path":["merchant","topups","recent"] } } }
      ]
    },
    {
      "name": "Transactions",
      "item": [
        { "name": "List", "request": { "method": "GET", "header": [ {"key":"Accept","value":"application/json"}, {"key":"Authorization","value":"Bearer {{token}}"} ], "url": { "raw": "{{base_url}}/transactions?type=&status=", "host":["{{base_url}}"], "path":["transactions"], "query":[{"key":"type","value":""},{"key":"status","value":""}] } } },
        { "name": "Recent", "request": { "method": "GET", "header": [ {"key":"Accept","value":"application/json"}, {"key":"Authorization","value":"Bearer {{token}}"} ], "url": { "raw": "{{base_url}}/transactions/recent", "host":["{{base_url}}"], "path":["transactions","recent"] } } },
        { "name": "Detail", "request": { "method": "GET", "header": [ {"key":"Accept","value":"application/json"}, {"key":"Authorization","value":"Bearer {{token}}"} ], "url": { "raw": "{{base_url}}/transactions/{{transaction_id}}", "host":["{{base_url}}"], "path":["transactions","{{transaction_id}}"] } } },
        { "name": "Receipt (JSON)", "request": { "method": "GET", "header": [ {"key":"Accept","value":"application/json"}, {"key":"Authorization","value":"Bearer {{token}}"} ], "url": { "raw": "{{base_url}}/transactions/{{transaction_id}}/receipt", "host":["{{base_url}}"], "path":["transactions","{{transaction_id}}","receipt"] } } },
        { "name": "Receipt Image (payload)", "request": { "method": "GET", "header": [ {"key":"Accept","value":"application/json"}, {"key":"Authorization","value":"Bearer {{token}}"} ], "url": { "raw": "{{base_url}}/transactions/{{transaction_id}}/receipt-image", "host":["{{base_url}}"], "path":["transactions","{{transaction_id}}","receipt-image"] } } },
        { "name": "Print (HTML)", "request": { "method": "GET", "header": [ {"key":"Authorization","value":"Bearer {{token}}"} ], "url": { "raw": "{{base_url}}/transactions/{{transaction_id}}/print", "host":["{{base_url}}"], "path":["transactions","{{transaction_id}}","print"] } } },
        { "name": "Verify Receipt", "request": { "method": "GET", "header": [ {"key":"Accept","value":"application/json"}, {"key":"Authorization","value":"Bearer {{token}}"} ], "url": { "raw": "{{base_url}}/transactions/{{transaction_id}}/verify", "host":["{{base_url}}"], "path":["transactions","{{transaction_id}}","verify"] } } }
      ]
    },
    {
      "name": "Statements",
      "item": [
        {
          "name": "Generate",
          "event": [ { "listen": "test", "script": { "exec": [
            "var d = pm.response.json();",
            "if (d.data && d.data.statement) { pm.collectionVariables.set('statement_id', d.data.statement.id); }"
          ], "type": "text/javascript" } } ],
          "request": { "method": "POST", "header": [ {"key":"Accept","value":"application/json"}, {"key":"Content-Type","value":"application/json"}, {"key":"Authorization","value":"Bearer {{token}}"} ], "url": { "raw": "{{base_url}}/statements", "host":["{{base_url}}"], "path":["statements"] }, "body": { "mode":"raw", "raw":"{\n  \"start_date\": \"2026-06-01\",\n  \"end_date\": \"2026-06-30\",\n  \"type\": \"all\"\n}" } }
        },
        { "name": "List", "request": { "method": "GET", "header": [ {"key":"Accept","value":"application/json"}, {"key":"Authorization","value":"Bearer {{token}}"} ], "url": { "raw": "{{base_url}}/statements", "host":["{{base_url}}"], "path":["statements"] } } },
        { "name": "Detail", "request": { "method": "GET", "header": [ {"key":"Accept","value":"application/json"}, {"key":"Authorization","value":"Bearer {{token}}"} ], "url": { "raw": "{{base_url}}/statements/{{statement_id}}", "host":["{{base_url}}"], "path":["statements","{{statement_id}}"] } } },
        { "name": "Download (payload)", "request": { "method": "GET", "header": [ {"key":"Accept","value":"application/json"}, {"key":"Authorization","value":"Bearer {{token}}"} ], "url": { "raw": "{{base_url}}/statements/{{statement_id}}/download", "host":["{{base_url}}"], "path":["statements","{{statement_id}}","download"] } } }
      ]
    }
  ]
}
